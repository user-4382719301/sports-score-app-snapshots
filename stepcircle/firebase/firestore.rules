rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isMe(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Am I an accepted friend of `uid`? (friendIds are only ever written by
    // the addFriend Cloud Function, so this list is trustworthy.)
    function isFriendOf(uid) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(db)/documents/users/$(uid)).data.friendIds;
    }

    match /users/{uid} {
      allow read: if isMe(uid) || isFriendOf(uid);
      allow create: if isMe(uid)
        && request.resource.data.friendIds == [];
      // Profile fields are editable; the friendship graph and server-maintained
      // aggregates are not.
      allow update: if isMe(uid)
        && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['friendIds', 'lifetimeSteps', 'streakDays', 'friendCode']);
      allow delete: if false;

      // Daily activity. hourlySteps reveals movement patterns, so if that
      // feels too exposed for your audience, strip it to aggregates in a
      // Cloud Function and tighten this read to owner-only.
      match /days/{date} {
        allow read: if isMe(uid) || isFriendOf(uid);
        allow write: if isMe(uid);
      }
    }

    // code -> uid lookup. Readable so addFriend can resolve codes (the
    // callable does the actual linking with admin rights); one code per user,
    // written once at profile creation.
    match /friendCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /feed/{id} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.audience;
      // Clients may only author cheers, as themselves, to accepted friends.
      // Ring/goal/award events are written by Cloud Functions.
      allow create: if isSignedIn()
        && request.resource.data.kind == 'cheer'
        && request.resource.data.friendId == request.auth.uid
        && request.resource.data.audience.size() >= 1
        && request.resource.data.audience.hasOnly(
             get(/databases/$(db)/documents/users/$(request.auth.uid)).data.friendIds);
      allow update, delete: if false;
    }

    match /competitions/{id} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      // Invites are client-created; points/status are server-owned after that.
      allow create: if isSignedIn()
        && request.resource.data.status == 'invited'
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.points.size() == 0;
      // The invitee may accept (invited -> active); nothing else changes.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds
        && resource.data.status == 'invited'
        && request.resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }
  }
}
